{
  "name": "purse-strings",
  "version": "0.0.0",
  "description": "Denial-of-wallet guard for LLM apps: per-user, per-session and global token, cost and request budgets, plus step, tool-call and time limits for agent loops. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Sean Chou (https://github.com/sean1093)",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "firestore": [
        "./dist/firestore.d.ts"
      ],
      "cloudflare": [
        "./dist/cloudflare.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./firestore": {
      "import": {
        "types": "./dist/firestore.d.ts",
        "default": "./dist/firestore.js"
      },
      "require": {
        "types": "./dist/firestore.d.cts",
        "default": "./dist/firestore.cjs"
      }
    },
    "./cloudflare": {
      "import": {
        "types": "./dist/cloudflare.d.ts",
        "default": "./dist/cloudflare.js"
      },
      "require": {
        "types": "./dist/cloudflare.d.cts",
        "default": "./dist/cloudflare.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:firestore": "vitest run --config vitest.integration.config.ts test/integration/firestore.test.ts",
    "test:cloudflare": "vitest run --config vitest.integration.config.ts test/integration/cloudflare-",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:exports": "attw --pack . && publint",
    "size": "size-limit",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "budget",
    "rate-limit",
    "cost",
    "tokens",
    "denial-of-wallet",
    "openai",
    "anthropic",
    "gemini",
    "agent",
    "guardrail",
    "cloudflare",
    "firestore"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean1093/purse-strings.git"
  },
  "bugs": {
    "url": "https://github.com/sean1093/purse-strings/issues"
  },
  "homepage": "https://github.com/sean1093/purse-strings#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@google-cloud/firestore": ">=7",
    "firebase-admin": ">=12"
  },
  "peerDependenciesMeta": {
    "@google-cloud/firestore": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@google-cloud/firestore": "^9.4.0",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "publint": "^0.3.25",
    "size-limit": "^13.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
